{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multiseat Lite",
  "version": "0.1.0",
  "identifier": "se.multiseat.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Multiseat Lite",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
